<!doctype html>
<html lang="{{ page.lang or metadata.language }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{ title or metadata.title }}</title>

		{#- Prevent light/dark theme flash before first paint -#}
		<script>
			(function () {
				try {
					var saved = localStorage.getItem("theme");
					if (saved === "light" || saved === "dark") {
						document.documentElement.setAttribute("data-theme", saved);
					}
				} catch (e) {}
			})();
		</script>

		{#- CSS bundles via eleventy-plugin-bundle #}
		{%- css %}* { box-sizing: border-box; }{% endcss %}
		{%- css %}{% include "public/css/index.css" %}{% endcss %}

		{#- Render the CSS bundle using Inlined CSS (for fastest site performance in production) #}
		<style>
			{% getBundle "css" %}
		</style>

		<meta name="description" content="{{ description or metadata.description }}">
		<meta name="generator" content="{{ eleventy.generator }}">

		{#- Canonical URL #}
		<link rel="canonical" href="{{ page.url | htmlBaseUrl(metadata.url) }}">

		{#- Multilingual hreflang annotations #}
		{%- set allAltLocales = page | getAlternateLocales(collections.all, translationKey) %}
		{%- for alt in allAltLocales %}
		<link rel="alternate" hreflang="{{ alt.lang }}" href="{{ alt.url | htmlBaseUrl(metadata.url) }}">
		{%- endfor %}
		{%- set enDefault = allAltLocales | filterByLang("en") | first %}
		{%- if enDefault %}
		<link rel="alternate" hreflang="x-default" href="{{ enDefault.url | htmlBaseUrl(metadata.url) }}">
		{%- endif %}

		{#- Open Graph tags #}
		<meta property="og:title" content="{{ title or metadata.title }}">
		<meta property="og:description" content="{{ description or metadata.description }}">
		<meta property="og:url" content="{{ page.url | htmlBaseUrl(metadata.url) }}">
		<meta property="og:site_name" content="{{ metadata.title }}">
		{%- if page.lang == "it" %}
		<meta property="og:locale" content="it_IT">
		{%- else %}
		<meta property="og:locale" content="en_US">
		{%- endif %}
		{%- if layout == "layouts/post.njk" or (tags and "posts" in tags) %}
		<meta property="og:type" content="article">
		{%- else %}
		<meta property="og:type" content="website">
		{%- endif %}
		{%- set ogImage = "" %}
		{%- if layout != "layouts/home.njk" %}
			{%- set ogImage = image | getOgImageUrl(content) %}
		{%- endif %}
		{%- if not ogImage %}
			{%- set ogImage = metadata.image %}
		{%- endif %}
		{%- if ogImage %}
		<meta property="og:image" content="{{ ogImage | htmlBaseUrl(metadata.url) }}">
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content="{{ title or metadata.title }}">
		<meta name="twitter:description" content="{{ description or metadata.description }}">
		<meta name="twitter:image" content="{{ ogImage | htmlBaseUrl(metadata.url) }}">
		{%- if image_alt %}
		<meta name="twitter:image:alt" content="{{ image_alt }}">
		{%- endif %}
		{%- endif %}

		{#- Atom and JSON feeds included by default #}
		<link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">
		<link rel="alternate" href="/feed/feed.json" type="application/json" title="{{ metadata.title }}">

		{#- From realfavicongenerator #}
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="manifest" href="/site.webmanifest">
		<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#c81e24">
		<meta name="msapplication-TileColor" content="#fcfcfd">
		<meta name="theme-color" content="#fcfcfd" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)">
	</head>
	<body>
		{%- set currentLang = page.lang or "en" %}
		<a href="#skip" class="visually-hidden">Skip to main content</a>

		<header id="header" class="site-header">
			<div class="content content--wide site-header-inner">
				<a href="{{ '/' | locale_url }}" class="home-link">
					<span class="name">Andrea</span>
					<span class="surname">Verlicchi</span>
				</a>

				<nav class="site-nav" aria-label="{{ strings[currentLang].topLevelNav }}">
					<ul class="nav">
						{%- for entry in collections.all | filterByLang(currentLang) | eleventyNavigation %}
							{% if entry.key !== "Home" %}
								{%- set isSectionActive = (entry.key == "Blog" and layout == "layouts/post.njk") %}
								<li class="nav-item">
									<a href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% elif isSectionActive %} data-active="true"{% endif %}>{{ entry.title }}</a>
								</li>
							{% endif %}
						{%- endfor %}
					</ul>
				</nav>

				<div class="header-actions">
					<button
						type="button"
						class="search-toggle"
						id="search-toggle"
						aria-label="{{ strings[currentLang].searchPostsLabel }}"
						aria-haspopup="dialog"
						aria-controls="search-dialog"
						title="{{ strings[currentLang].searchPostsLabel }}"
					>
						<svg class="search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="11" cy="11" r="7"></circle>
							<path d="m21 21-4.35-4.35"></path>
						</svg>
						<span class="search-toggle-label">{{ strings[currentLang].search }}</span>
						<kbd class="search-toggle-kbd" aria-hidden="true">/</kbd>
					</button>

					<button
						type="button"
						class="theme-toggle"
						id="theme-toggle"
						aria-label="{{ strings[currentLang].toggleTheme }}"
						title="{{ strings[currentLang].toggleTheme }}"
					>
						<svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="12" r="4"></circle>
							<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
						</svg>
						<svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
						</svg>
					</button>

					<div class="header-lang-switch">
						{%- set allAltLocales = page | getAlternateLocales(collections.all, translationKey) %}
						{%- set otherLocales = allAltLocales | filterOtherLangs(currentLang) %}
						{%- if otherLocales | length > 0 %}
							{%- for alt in otherLocales %}
								{%- if alt.url != "/" and alt.url != "/index.html" %}
								<a href="{{ alt.url }}" class="lang-switch" lang="{{ alt.lang }}" title="{{ 'Switch to English' if alt.lang == 'en' else 'Passa all\'Italiano' }}">
									{% if alt.lang == "en" %}<span aria-hidden="true">🇬🇧</span><span class="lang-label-full">English</span><span class="lang-label-short">EN</span>{% else %}<span aria-hidden="true">🇮🇹</span><span class="lang-label-full">Italiano</span><span class="lang-label-short">IT</span>{% endif %}
								</a>
								{%- endif %}
							{%- endfor %}
						{%- else %}
							{%- if currentLang == "en" %}
								<a href="/it/" class="lang-switch" lang="it" title="Passa all'Italiano"><span aria-hidden="true">🇮🇹</span><span class="lang-label-full">Italiano</span><span class="lang-label-short">IT</span></a>
							{%- else %}
								<a href="/en/" class="lang-switch" lang="en" title="Switch to English"><span aria-hidden="true">🇬🇧</span><span class="lang-label-full">English</span><span class="lang-label-short">EN</span></a>
							{%- endif %}
						{%- endif %}
					</div>
				</div>
			</div>
		</header>

		<main id="skip" class="site-main">
			<div class="content {{ 'content--wide' if wideLayout else 'content--prose' }}">
				{{ content | safe }}
			</div>
		</main>

		<footer class="site-footer">
			<div class="content content--wide site-footer-inner">
				<p class="footer-note">Andrea Verlicchi · {{ strings[currentLang].endOfPage }}</p>
				<a href="#header" class="footer-top-link">
					<span aria-hidden="true">&uarr;</span> {{ strings[currentLang].toTheTop }}
				</a>
			</div>
		</footer>

		<dialog
			id="search-dialog"
			class="search-dialog"
			aria-labelledby="search-dialog-label"
			data-index-url="{{ ('/' + currentLang + '/search-index.json') | url }}"
		>
			<div class="search-dialog-panel">
				<div class="search-dialog-header">
					<svg class="search-input-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="11" cy="11" r="7"></circle>
						<path d="m21 21-4.35-4.35"></path>
					</svg>
					<label id="search-dialog-label" for="search-dialog-input" class="visually-hidden">
						{{ strings[currentLang].searchPostsLabel }}
					</label>
					<input
						type="search"
						id="search-dialog-input"
						class="search-dialog-input"
						placeholder="{{ strings[currentLang].searchPlaceholder }}"
						autocomplete="off"
						autocorrect="off"
						autocapitalize="off"
						spellcheck="false"
						enterkeyhint="search"
						aria-controls="search-dialog-results"
					>
					<button
						type="button"
						id="search-dialog-clear"
						class="search-dialog-clear"
						aria-label="{{ strings[currentLang].searchClear }}"
						hidden
					>
						<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="12" r="9"></circle>
							<path d="m15 9-6 6M9 9l6 6"></path>
						</svg>
					</button>
					<button
						type="button"
						id="search-dialog-close"
						class="search-dialog-close"
						aria-label="{{ strings[currentLang].searchClose }}"
					>
						<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M18 6 6 18M6 6l12 12"></path>
						</svg>
					</button>
				</div>

				<div id="search-dialog-status" class="search-dialog-status" role="status" aria-live="polite" aria-atomic="true">
					{{ strings[currentLang].searchEmptyPrompt }}
				</div>

				<div id="search-dialog-body" class="search-dialog-body">
					<div id="search-dialog-tags" class="search-dialog-tags" hidden></div>
					<p id="search-dialog-empty" class="search-dialog-empty" hidden>{{ strings[currentLang].searchNoResultsHint }}</p>
					<ul id="search-dialog-results" class="search-dialog-results" aria-label="{{ strings[currentLang].searchPostsLabel }}"></ul>
				</div>

				<div class="search-dialog-footer" aria-hidden="true">
					<span><kbd>&uarr;</kbd><kbd>&darr;</kbd> {{ strings[currentLang].searchKeyNavigate }}</span>
					<span><kbd>&crarr;</kbd> {{ strings[currentLang].searchKeyOpen }}</span>
					<span><kbd>Esc</kbd> {{ strings[currentLang].searchKeyClose }}</span>
				</div>
			</div>
		</dialog>

		<script type="application/json" id="search-i18n">
			{{ {
				lang: currentLang,
				minRead: strings[currentLang].minRead,
				emptyPrompt: strings[currentLang].searchEmptyPrompt,
				popularKeywords: strings[currentLang].searchPopularKeywords,
				noResults: strings[currentLang].searchNoResults,
				noResultsHint: strings[currentLang].searchNoResultsHint,
				resultsSingular: strings[currentLang].searchResultsSingular,
				resultsPlural: strings[currentLang].searchResultsPlural,
				ofTotal: strings[currentLang].searchOfTotal,
				loading: strings[currentLang].searchLoading,
				error: strings[currentLang].searchError,
				reset: strings[currentLang].searchReset
			} | dump | safe }}
		</script>

		<script src="{{ '/js/search.js' | url }}" defer></script>

		<script>
			(function () {
				var btn = document.getElementById("theme-toggle");
				if (!btn) return;
				var root = document.documentElement;
				var media = window.matchMedia("(prefers-color-scheme: dark)");

				function getActiveTheme() {
					var explicit = root.getAttribute("data-theme");
					if (explicit === "light" || explicit === "dark") return explicit;
					return media.matches ? "dark" : "light";
				}

				function syncAria() {
					btn.setAttribute("aria-pressed", String(getActiveTheme() === "dark"));
				}

				btn.addEventListener("click", function () {
					var next = getActiveTheme() === "dark" ? "light" : "dark";
					root.setAttribute("data-theme", next);
					try {
						localStorage.setItem("theme", next);
					} catch (e) {}
					syncAria();
				});

				if (media.addEventListener) {
					media.addEventListener("change", syncAria);
				}
				syncAria();
			})();
		</script>

		{#- Google tag (gtag.js) #}
		<script async fetchpriority="low" src="https://www.googletagmanager.com/gtag/js?id=G-HGPGLLETP8"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());

			gtag('config', 'G-HGPGLLETP8');
		</script>

		<!-- Current page: {{ page.url | htmlBaseUrl }} -->
	</body>
</html>
