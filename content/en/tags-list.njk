---
permalink: /en/tags/
layout: layouts/home.njk
---
{% set allTags = collections.posts_en | getAllTags | filterTagList | sort %}

<header class="page-header">
	<h1>Tags</h1>
	<p class="page-subtitle">{{ allTags | length }} topics</p>
</header>

<ul class="tags-cloud">
{% for tag in allTags %}
	{% set tagUrl %}{{ ("/tags/" + (tag | slugify) + "/") | locale_url }}{% endset %}
	<li><a href="{{ tagUrl }}" class="post-tag">{{ tag }}</a></li>
{% endfor %}
</ul>
