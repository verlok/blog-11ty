---
pagination:
  data: collections.tags_en
  size: 1
  alias: tag
  addAllPagesToCollections: true
layout: layouts/home.njk
eleventyComputed:
  title: Tagged “{{ tag }}”
permalink: /en/tags/{{ tag | slugify }}/
---
{% set postslist = collections[ tag ] | filterByLang("en") %}

<header class="page-header">
	<h1>Tagged “{{ tag }}”</h1>
	<p class="page-subtitle">{{ postslist | length }} article{% if postslist | length != 1 %}s{% endif %}</p>
</header>

{% include "postslist.njk" %}

<div class="archive-cta">
	<p><a href="{{ '/tags/' | locale_url }}">&larr; {{ strings.en.seeAllTags }}</a></p>
</div>
