---
layout: layouts/home.njk
eleventyNavigation:
  key: Home
  order: 1
numberOfLatestPostsToShow: 9
---
{% set postsCount = collections.posts_it | length %}

<section class="home-hero">
	<p class="home-kicker">{{ strings.it.heroKicker }}</p>
	<h1>{{ strings.it.tagline }}.</h1>
	<p class="home-intro">
		Ciao, sono <a href="{{ '/about/' | locale_url }}">Andrea Verlicchi</a>. Scrivo articoli pratici su Core Web Vitals, architettura front-end e ottimizzazione delle performance web.
	</p>
</section>

<div class="section-header">
	<span class="section-title">{{ strings.it.latestArticles }}</span>
	<a href="{{ '/blog/' | locale_url }}" class="section-meta-link">{{ postsCount }} {{ strings.it.inArchive }} &rarr;</a>
</div>

{% set postslist = collections.posts_it | head(-1 * numberOfLatestPostsToShow) %}
{% set featuredFirst = true %}
{% include "postslist.njk" %}

{% set morePosts = postsCount - numberOfLatestPostsToShow %}
{% if morePosts > 0 %}
<div class="archive-cta">
	<p>Puoi trovare altri {{ morePosts }} articol{% if morePosts != 1 %}i{% else %}o{% endif %} nell'<a href="{{ '/blog/' | locale_url }}">archivio</a>.</p>
</div>
{% endif %}
