---
layout: layouts/home.njk
eleventyNavigation:
  key: Blog
  order: 2
---

<header class="page-header">
	<h1>Blog</h1>
	<p class="page-subtitle">{{ collections.posts_it | length }} {{ strings.it.inArchive }}</p>
</header>

<div class="blog-search" data-total-count="{{ collections.posts_it | length }}">
	<div class="blog-search-field">
		<svg class="blog-search-icon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="11" cy="11" r="7"></circle>
			<path d="m21 21-4.35-4.35"></path>
		</svg>
		<label for="blog-search-input" class="visually-hidden">{{ strings.it.searchPostsLabel }}</label>
		<input
			type="search"
			id="blog-search-input"
			class="blog-search-input"
			placeholder="{{ strings.it.searchShortPlaceholder }}"
			autocomplete="off"
			autocorrect="off"
			autocapitalize="off"
			spellcheck="false"
			enterkeyhint="search"
		>
		<button type="button" id="blog-search-clear" class="blog-search-clear" aria-label="{{ strings.it.searchClear }}" hidden>
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M18 6 6 18M6 6l12 12"></path>
			</svg>
		</button>
	</div>
	<p id="blog-search-status" class="blog-search-status" role="status" aria-live="polite" aria-atomic="true" hidden></p>
</div>

{% set postslist = collections.posts_it %}
{% set enableSearch = true %}
{% include "postslist.njk" %}

<div id="blog-search-empty" class="blog-search-empty" hidden>
	<p id="blog-search-empty-title" class="blog-search-empty-title"></p>
	<p class="blog-search-empty-hint">{{ strings.it.searchNoResultsHint }}</p>
	<button type="button" id="blog-search-reset" class="blog-search-reset">{{ strings.it.searchReset }}</button>
</div>
