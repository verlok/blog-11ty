---
pagination:
  data: collections.tags_it
  size: 1
  alias: tag
  addAllPagesToCollections: true
layout: layouts/home.njk
eleventyComputed:
  title: Articoli con tag “{{ tag }}”
permalink: /it/tags/{{ tag | slugify }}/
---
{% set postslist = collections[ tag ] | filterByLang("it") %}

<header class="page-header">
	<h1>Tag “{{ tag }}”</h1>
	<p class="page-subtitle">{{ postslist | length }} articol{% if postslist | length != 1 %}i{% else %}o{% endif %}</p>
</header>

{% set activeTag = tag %}
{% include "topicsbar.njk" %}

{% include "postslist.njk" %}

<div class="archive-cta">
	<p><a href="{{ '/tags/' | locale_url }}">&larr; {{ strings.it.seeAllTags }}</a></p>
</div>
